# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Optional in dev.
NEXT_PUBLIC_GA_ID=

# Brevo (formerly Sendinblue) API key for transactional email + contact list.
# Get from brevo.com → SMTP & API → API keys. Keep server-only.
BREVO_API_KEY=

# Brevo contact list ID to add new leads to (numeric).
BREVO_LIST_ID=

# Public URL where the ebook PDF lives (or a /ebook/* path served from /public).
EBOOK_DOWNLOAD_URL=/ebook/afrodite-prazer-7-etapas.pdf
