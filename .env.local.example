# Copie este arquivo para .env.local só se quiser testar o Brevo no seu computador.
# Sem nada preenchido o site funciona normalmente (os cadastros aparecem no terminal).

# Google Analytics 4 (ex.: G-XXXXXXXXXX). Opcional.
NEXT_PUBLIC_GA_ID=

# Segredo que assina os links pessoais do ebook (/guia/ler?t=...).
# Em produção já está configurado no Railway — não troque, senão os links antigos param de abrir.
EBOOK_TOKEN_SECRET=

# Brevo: chave de API, número da lista e remetente validado.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=contato@afroditeprazer.com.br
# Para onde vão as respostas (o remetente acima não tem caixa de entrada). Ex.: seu Gmail.
BREVO_REPLY_TO=

# Endereço público do site, usado nos links dos e-mails (ex.: https://afroditeprazer.com.br).
SITE_URL=

# Coloque 1 quando a sequência de e-mails estiver ativa no Brevo:
# o final do ebook passa a anunciar "Fica de olho no seu e-mail".
EMAIL_SEQUENCE_ACTIVE=
